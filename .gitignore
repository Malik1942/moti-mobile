timeline.xctimeline
playground.xcworkspace/

# Moti/Secrets.swift is INTENTIONALLY tracked (CI needs it to compile).
# The committed copy holds only nil placeholders. To keep your local edits
# out of git, run once per clone:
#   git update-index --skip-worktree Moti/Secrets.swift
